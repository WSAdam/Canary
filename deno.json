{
  "tasks": {
    "start": "deno run --allow-net --allow-env --unstable-cron --unstable-kv --env-file main.ts",
    "dev": "deno run --allow-net --allow-env --unstable-cron --unstable-kv --env-file --watch main.ts",
    "test": "deno test --allow-net --allow-env dist.rune/",
    "check": "deno check main.ts e2e.ts"
  },
  "compilerOptions": {
    "strict": true
  },
  "unstable": ["kv", "cron"]
}
